# Secrets — copier vers ./.env.deploy (gitignoré) et remplir.
# Format Makefile : KEY=value, sans espaces, sans guillemets.

# --- Scaleway (auth provider Terraform + registre partagé) ---
SCW_ACCESS_KEY=SCWXXXXXXXXXXXXXXXXXX
SCW_SECRET_KEY=00000000-0000-0000-0000-000000000000
SCW_DEFAULT_PROJECT_ID=00000000-0000-0000-0000-000000000000
SCW_DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000

# --- Base de données Lampion ---
# Seule dépendance DB : cette clé API. DATABASE_URL est résolu automatiquement (projets
# Lampion « traversal » en dev et « traversal-prod » en prod, créés s'ils n'existent pas). Clé : Settings > API Keys.
LAMPION_API_KEY=lmp_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LAMPION_REGION=fr-par-1          # optionnel (défaut fr-par-1)
# DATABASE_URL=postgresql://...    # optionnel : force une URL et court-circuite Lampion

# --- Import de parties traversalgame.com (page Analyse) ---
# Compte (dédié de préférence) avec lequel le backend lit les parties. Sans : import fermé.
# TRAVERSAL_LOGIN=email@exemple.fr
# TRAVERSAL_PASSWORD=...

# --- Emails transactionnels (Scaleway TEM) et URL publique ---
# Domaine d'expédition à vérifier dans TEM (DNS SPF/DKIM). Sans ces clés : aucun email.
# PUBLIC_URL=https://mon-site.fr
# MAIL_FROM=noreply@mon-site.fr
# TEM_PROJECT_ID=00000000-0000-0000-0000-000000000000
# TEM_SECRET_KEY=00000000-0000-0000-0000-000000000000
