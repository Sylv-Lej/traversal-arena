# Traversal — aucun secret propre au site : tout vient de ./.env.deploy (racine).
#   make dev   -> base Lampion « traversal » (LAMPION_API_KEY requis)
# docker-compose fournit API_URL / API_KEY de dev au front et au back.

# --- Backend ---
API_KEY=dev-local-key-not-a-secret
EXPOSE_DOCS=1
# DATABASE_URL=    # résolu par le Makefile depuis LAMPION_API_KEY ; vide = mémoire

# --- Frontend (variables SERVEUR, jamais NEXT_PUBLIC_) ---
API_URL=http://localhost:8000
